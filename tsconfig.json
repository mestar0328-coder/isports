{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "app/admin/page.tsxxx", "app/admin/page.tsxx", "app/admin/page.tsx.duplicate", "app/scoring/matches/[id]/page.tsx.duplicate", "app/scoring/matches/page.tsx.duplicate", "app/scoring/brackets/page.tsx.duplicate", "app/scoring/results/page.tsx.dulplicate", "app/scoring/results/page.tsx.duplicate", "app/scoring/standings/page.tsx.duplicate", "app/scoring/matches/[id]/page.tsx.duplicate", "app/scoring/scoreboard/page.tsx.duplicate", "app/scoring/public-results/page.tsx.duplicate", "app/scoring/dashboard/page.tsx.duplicate", "app/admin/pagelayout.tsx", "app/scoring/matches/page.tsx.duplicate", "app/scoring/page.tsx.duplicate", "components/Navbar.tsx.doublecate", "app/layout.tsx.duplicate", "data/tempCodeRunnerFile.ts.duplicate", "data/incharges.ts", "data/sportsStorage.ts", "data/events.ts.d"  ],
  "exclude": ["node_modules"]
}
